<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wmx_r2_control</name>
  <version>0.1.0</version>
  <description>
    ros2_control hardware interface (SystemInterface) for the WMX3 EtherCAT motion
    control SDK, plus controller configs and launch files for the differential drive and
    manipulator. Drives WMX3 axes from standard ros2_controllers
    (diff_drive_controller, joint_trajectory_controller, joint_state_broadcaster).
  </description>
  <maintainer email="mfikih@movensys.com">Fikih Muhamad</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <!-- ros2_control runtime: controller_manager + standard controllers -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>

  <!-- launch / description -->
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>wmx_r2_package</exec_depend>
  <exec_depend>movensys_navigation_description</exec_depend>
  <exec_depend>movensys_manipulator_description</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/wmx_r2_control_plugin.xml"/>
  </export>
</package>
